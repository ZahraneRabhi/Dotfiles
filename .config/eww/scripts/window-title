#!/bin/bash
# Stream active window title to eww

hyprctl activewindow -j 2>/dev/null | jq -r '.title // ""' 2>/dev/null

HYPR_SOCK="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

ncat -U "$HYPR_SOCK" 2>/dev/null | while IFS= read -r line; do
  event="${line%%>>*}"
  case "$event" in
    activewindow)
      # Format: activewindow>>class,title
      title="${line#*>>}"
      title="${title#*,}"
      echo "$title"
      ;;
    closewindow)
      echo ""
      ;;
  esac
done
