#!/bin/bash
# Stream open windows to eww as Windows-XP taskbar buttons.
# Output: JSON array [{address, title, class, active}], one line per update.

emit() {
  local active
  active=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""' 2>/dev/null)
  hyprctl clients -j 2>/dev/null | \
    jq -c --arg a "$active" \
      '[ .[]
         | select(.mapped == true and .workspace.id >= 0 and ((.hidden // false) | not))
         | { address: .address,
             title:   (.title  // ""),
             class:   (.class  // ""),
             active:  (.address == $a) } ]' 2>/dev/null
}

emit

HYPR_SOCK="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

ncat -U "$HYPR_SOCK" 2>/dev/null | while IFS= read -r line; do
  event="${line%%>>*}"
  case "$event" in
    openwindow|closewindow|movewindow|movewindowv2|\
    activewindow|activewindowv2|windowtitle|windowtitlev2|\
    changefloatingmode|fullscreen|urgent|workspace|focusedmon)
      emit
      ;;
  esac
done
