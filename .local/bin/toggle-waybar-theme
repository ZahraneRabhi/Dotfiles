# --- Wofi menu with wallpaper previews ---
generate_wofi_items() {
  for entry in "${THEMES[@]}"; do
    IFS=":" read -r NAME WALLPAPER WAYBAR_THEME HYPR_THEME FOOT_THEME <<<"$entry"
    SAFE_NAME=$(printf "%s" "$NAME" | tr -cs '[:alnum:]' '_')
    THUMB="$THUMB_DIR/${SAFE_NAME}.png"
    if [[ ! -f "$THUMB" && -f "$WALLPAPER" ]]; then
      ffmpeg -i "$WALLPAPER" \
        -vf "scale=200:112:force_original_aspect_ratio=decrease,pad=200:112:(ow-iw)/2:(oh-ih)/2:color=black" \
        -frames:v 1 "$THUMB" -y -loglevel quiet 2>/dev/null
    fi
    if [[ -f "$THUMB" ]]; then
      printf "img:%s:text:%s\n" "$THUMB" "$NAME"
    else
      printf "%s\n" "$NAME"
    fi
  done
}

# --restore (login): re-apply the saved theme without the menu
if [[ "$1" == "--restore" ]]; then
  RESTORE=1
  SELECTED=$(cat "$THEME_STATE" 2>/dev/null)
  # hyprpaper starts alongside us at login; wait up to 5s for its IPC
  for _ in {1..50}; do hyprctl hyprpaper listactive >/dev/null 2>&1 && break; sleep 0.1; done
else
  SELECTED=$(generate_wofi_items |
    wofi --dmenu \
      --allow-images \
      --prompt "Select Theme" \
      --width 820 \
      --height 600 \
      --lines 10 \
      --columns 2 \
      --cache-file /dev/null |
    sed 's|^img:[^:]*:text:||')

  [ -z "$SELECTED" ] && exit 0
fi

# --- Apply selected theme ---
for entry in "${THEMES[@]}"; do
  IFS=":" read -r NAME WALLPAPER WAYBAR_THEME HYPR_THEME FOOT_THEME <<<"$entry"
  if [[ "$NAME" == "$SELECTED" ]]; then

    # Apply symlinks
    ln -sf "$WAYBAR_THEME" "$WAYBAR_DIR/style.css"
    ln -sf "$HYPR_THEME" "$ACTIVE_HYPR"
    ln -sf "$FOOT_THEME" "$ACTIVE_FOOT"
    #pkill -x foot 2>/dev/null

    # Apply wallpaper per monitor
    for monitor in $(hyprctl monitors -j | jq -r '.[].name'); do
      hyprctl hyprpaper wallpaper "$monitor,$WALLPAPER"
    done

    # Write state for Waybar widget (triggers inotifywait instantly)
    echo "$NAME" >"$THEME_STATE"

    # Reload Hyprland config (skipped at login, the config is freshly loaded)
    [[ -z "$RESTORE" ]] && hyprctl reload
    MATCHED=1

    # Bar: WINDOWS XP uses the eww Luna taskbar (on every monitor); other themes use Waybar
    close_xp_bars() {
      eww active-windows 2>/dev/null | awk -F: '/xp-bar/{print $1}' | while read -r w; do
        eww close "$w" >/dev/null 2>&1
      done
    }
    if [[ "$NAME" == "WINDOWS XP" ]]; then
      pkill -x waybar 2>/dev/null
      eww ping >/dev/null 2>&1 || eww daemon >/dev/null 2>&1
      eww reload >/dev/null 2>&1
      eww close retro-bar >/dev/null 2>&1
      close_xp_bars
      for mon in $(hyprctl monitors -j | jq -r '.[].id'); do
        eww open xp-bar --id "xp-bar-$mon" --screen "$mon" >/dev/null 2>&1
      done
    else
      close_xp_bars
      pkill -x waybar 2>/dev/null
      sleep 0.5
      nohup waybar >/dev/null 2>&1 &
      disown
    fi

    [[ -z "$RESTORE" ]] && notify-send "Theme switched" "Now using: $NAME"
    break
  fi
done

# Saved theme missing or renamed: still give the user a bar
[[ -n "$RESTORE" && -z "$MATCHED" ]] && exec waybar
